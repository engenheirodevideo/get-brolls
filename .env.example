# Shell environment takes precedence. No interpolation or shell commands.
GB_PREVIEW_MODE=gif
# broll: animate only the insert; full: use supplied composition of this insert.
GB_GIF_SCOPE=broll
GB_GIF_WIDTH=360
GB_GIF_FPS=8
GB_GIF_COLORS=128
GB_GIF_MAX_MB=5
GB_PREVIEW_MAX_SECONDS=10
GB_STATIC_FRAMES=12
# Optional provider keys; never commit real secrets.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional rules path; empty uses project/RULES.md then skill template.
GB_RULES_FILE=

# Caminhos explícitos das ferramentas; vazio mantém a descoberta padrão.
# Executável do yt-dlp; vence a busca em .venv e no PATH.
# GB_YTDLP_PATH=
# Pasta .venv usada para localizar o yt-dlp; padrão é .venv na raiz da skill.
# GB_VENV_PATH=
# Executável do FFmpeg; padrão é ffmpeg no PATH.
# GB_FFMPEG_PATH=
# Executável do ffprobe; padrão é ffprobe no PATH.
# GB_FFPROBE_PATH=

# Fonte TrueType para rotular o contact sheet (CLI `preview` e helpers Bash de YouTube);
# vazio mantém a descoberta de DejaVu/Liberation/Arial no sistema.
# GB_FONT_FILE=

# Ritmo da fila social (`gb.py queue`): pausa aleatória entre itens e tetos de itens/hora e itens/dia.
# Valem globalmente (mesmo valor pra todo provedor) quando definidas; para diferenciar por
# provedor, use o bloco opcional "pacing" em RULES.md — a variável de ambiente vence quando definida.
# Vazio mantém os padrões (Instagram 45–120 s; TikTok/YouTube 15–40 s; 20/hora; 60/dia).
# GB_PACE_MIN_S=
# GB_PACE_MAX_S=
# GB_MAX_PER_HOUR=
# GB_MAX_PER_DAY=
# Pausas do yt-dlp entre pedidos, como "requests,min,max" em segundos (padrão 1,3,8).
# GB_YTDLP_SLEEP=
