# ─────────────────────────────────────────────────────────────────────
# GET B-ROLLS — settings
# ─────────────────────────────────────────────────────────────────────
# Everything here is OPTIONAL. The skill works with no .env at all.
#
# How to use this file
#   1. Copy it to `.env` in the skill's root folder (next to this file).
#      To keep it somewhere else, pass `--env-file /path/to/.env`.
#   2. Uncomment only the lines you want to change.
#
# Rules of the format
#   - One `KEY=value` per line. Quotes are optional: KEY="value" works.
#   - No variable interpolation and no shell commands: `$HOME` and
#     `$(...)` are NOT expanded. Write full paths.
#   - A variable already exported in your shell wins over this file.
#   - An unknown key is an error, so a typo shows up immediately
#     instead of being silently ignored.
#   - An empty value (`KEY=`) means "use the default".
#
# Never commit a real `.env`. It is git-ignored; keep API keys private.
# Run `python3 scripts/gb.py doctor` to see what is active and what is missing.


# ── Previews ─────────────────────────────────────────────────────────
# What the reviewer sees before anything is downloaded in full.

# Preview type.
#   gif     animated preview of the segment, plus poster and contact sheet (default)
#   static  poster and contact sheet only, no animation
GB_PREVIEW_MODE=gif

# What the GIF animates.
#   broll   only the insert itself (default)
#   full    the supplied composition of this insert
GB_GIF_SCOPE=broll

# GIF width in pixels. Range: 160–720. Default: 360.
# Raise it for footage with small details (UI, text); lower it if previews feel heavy.
GB_GIF_WIDTH=360

# GIF frames per second. Range: 2–18. Default: 8.
GB_GIF_FPS=8

# GIF palette size. Range: 32–256. Default: 128. Fewer colors = smaller file.
GB_GIF_COLORS=128

# Maximum GIF size in MB. Range: 1–30. Default: 5.
GB_GIF_MAX_MB=5

# Longest segment a single `preview` accepts, in seconds. Range: 1–30. Default: 10.
# Longer candidates must be previewed in parts.
GB_PREVIEW_MAX_SECONDS=10

# Number of frames in the contact sheet. Range: 1–30. Default: 12.
GB_STATIC_FRAMES=12

# Ceiling for `preview --scan` (scanning a whole video), in seconds.
# Range: 30–7200. Default: 900. The scan downloads this much working media.
# GB_SCAN_MAX_SECONDS=900


# ── Provider API keys ────────────────────────────────────────────────
# YouTube, Instagram, TikTok, Wikimedia Commons and NASA need NO key.
# Stock libraries do: without the key, that provider's search is simply off.
# Keys are redacted from logs and error messages.

# Pexels — free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# YouTube Data API key. Optional: YouTube search works without it.
YOUTUBE_API_KEY=


# ── Rules and brief ──────────────────────────────────────────────────
# Editorial rules are layered, later layers win:
#   ~/.getbrolls/RULES.md  →  GB_RULES_FILE  →  <project>/RULES.md
# With no project RULES.md, the skill's template (docs/RULES.md) is the base.

# Extra rules file applied to every project on this machine. Must exist.
# Example: GB_RULES_FILE=/path/to/shared/RULES.md
GB_RULES_FILE=

# Alternative BRIEF.md location. Default: <project>/BRIEF.md.
# A path outside the project folder applies to every project on this machine.
# GB_BRIEF_FILE=


# ── Personal folder and library ──────────────────────────────────────
# Personal folder: your global RULES.md and the cross-project library of
# "what worked before". Default: ~/.getbrolls
# GB_HOME=

# Set to `off` to disable the global library: `learn` and `library`
# neither read nor write anything.
# GB_LIBRARY=off


# ── Tool paths ───────────────────────────────────────────────────────
# Leave these empty unless `doctor` cannot find a tool. An explicit path
# always wins over automatic discovery. Each path must exist.

# yt-dlp executable. Default: the skill's .venv, then your PATH.
# GB_YTDLP_PATH=

# The .venv folder used to locate yt-dlp. Default: .venv in the skill's root.
# GB_VENV_PATH=

# FFmpeg executable. Default: `ffmpeg` on your PATH.
# Example: GB_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# GB_FFMPEG_PATH=

# ffprobe executable. Default: `ffprobe` on your PATH.
# GB_FFPROBE_PATH=


# ── Contact sheet font ───────────────────────────────────────────────
# TrueType font used to label the contact sheet. Default: the first of
# DejaVu, Liberation or Arial found on the system. Must exist when set.
# GB_FONT_FILE=


# ── Social queue pacing ──────────────────────────────────────────────
# `gb.py queue` spaces out Instagram, TikTok and YouTube downloads so the
# source does not block you. Defaults:
#   pause between items   Instagram 45–120 s · TikTok and YouTube 15–40 s
#   ceilings              20 items per hour · 60 items per day
#
# These variables apply the SAME value to every provider and win over
# RULES.md. To tune one provider only, use the optional "pacing" block
# in RULES.md instead.

# Random pause between items, in seconds. Range: 0–86400 each.
# GB_PACE_MIN_S=
# GB_PACE_MAX_S=

# Ceilings. Range: 1–10000 per hour, 1–100000 per day.
# GB_MAX_PER_HOUR=
# GB_MAX_PER_DAY=

# yt-dlp pauses between its own requests: "requests,min,max" in whole
# seconds, with min <= max. Default: 1,3,8
# GB_YTDLP_SLEEP=1,3,8


# ── Cache and delivery ───────────────────────────────────────────────
# Local cache folder (provider responses and FFmpeg capability probes).
# Default: ~/.cache/getbrolls
# The old name GETBROLLS_CACHE_DIR still works when exported in your shell;
# when both are set, GB_CACHE_DIR wins.
# GB_CACHE_DIR=

# `deliver` normally hard-links the clips into entrega/ (no extra disk space).
# Set to 1 to get independent copies you can edit in place.
# GB_DELIVERY_COPY=1
