# Fim de linha estável: o checkout do Windows não pode transformar um script
# de shell em CRLF (bash recusa) nem tirar o CRLF de um script do PowerShell.
* text=auto
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
# Plugins oficiais: o pin é o hash dos bytes, então o checkout do Windows não pode trocar o fim de linha.
plugins_official/** text eol=lf
# Modelos que `init-rules`/`init-brief` copiam: o mesmo texto (e hash) no checkout do Windows e no wheel.
docs/RULES.md text eol=lf
docs/BRIEF.md text eol=lf

# Defesa em profundidade: material de trabalho interno fica fora de qualquer
# `git archive`, mesmo que um dia volte a ser versionado por engano. A defesa
# principal continua sendo o teste-guarda, que impede esses caminhos no índice.
docs/superpowers/ export-ignore
docs/discovery/ export-ignore
.superpowers/ export-ignore
.claude/ export-ignore
.agents/ export-ignore
.codex/ export-ignore
.playwright-cli/ export-ignore
# Ouro da 2.5: bytes exatos em todo sistema (sem conversão de fim de linha).
tests/fixtures/golden_v25/** -text
