# Régua do pylint só para tests/. Repete os limites do pyproject.toml
# (--rcfile não herda: só copia o que está definido abaixo) e desliga apenas o
# que é intrínseco ao jeito como esta suíte com unittest é escrita — nunca um
# desconto geral de qualidade.
#
# `PYTHONPATH=scripts:tests pylint --rcfile tests/pylintrc tests`

[MAIN]
py-version = 3.11

[FORMAT]
max-line-length = 120

[MESSAGES CONTROL]
disable =
    # O nome do método de teste é a própria documentação (test_algo_bem_especifico);
    # exigir docstring em cada um duplicaria o nome em prosa.
    missing-function-docstring,
    missing-class-docstring,
    missing-module-docstring,
    # Testes exercitam internals de propósito (estado interno, atributo "privado"
    # do objeto sob teste) — isso não é acoplamento indevido aqui.
    protected-access,
    # Uma classe TestCase por cenário é o padrão do unittest, não falta de coesão;
    # uma classe com dezenas de test_* também é normal nesta suíte.
    too-few-public-methods,
    too-many-public-methods,
    # Assinaturas de mock/patch/fake replicam a função real que substituem;
    # parâmetros não usados ali são propositais (o ruff já ignora ARG em tests/*
    # pelo mesmo motivo, em pyproject.toml).
    unused-argument,
    # Fixtures parecidas entre testes são parecidas de propósito: cada teste
    # fica legível e independente, sem indireção para "não repetir".
    duplicate-code,
    # Falso positivo sistemático: tests/test_plugin_hyperframes*.py carrega o
    # plugin de exemplo com exec() num types.ModuleType (load_plugin(), em
    # test_plugin_hyperframes.py), do mesmo jeito que o loader de produção faz.
    # O pylint não consegue inferir estaticamente os atributos de um módulo
    # montado em runtime, então sinaliza "no-member" para cada atributo real do
    # plugin (HYPERFRAMES_VERSION, generate, MediaUseResolver, ...). As 58
    # ocorrências da baseline vêm inteiras desses 3 arquivos; nenhuma é erro real
    # (confirmado por rodar a suíte). Desligado em todos os testes, não só
    # nesses 3 arquivos: o `disable` deste rcfile vale para a pasta inteira.
    no-member,
    # Falso positivo sistemático: vários testes reimportam um módulo da stdlib já
    # importado no topo do arquivo (json, sys, tempfile, subprocess, io, Path,
    # patch, http, queue, social, re, argparse, time, logs, PluginApi, Registry)
    # dentro do próprio método de teste, para isolar o setup daquele teste
    # específico (o mesmo padrão de import tardio que PLC0415/import-outside-toplevel
    # cobre no ruff e no pylint principal). O nome local sombreia o import de
    # módulo, o que W0621 aponta como "redefined-outer-name" sem ser um bug —
    # não há uso acidental do símbolo errado em nenhuma ocorrência da baseline.
    redefined-outer-name,
