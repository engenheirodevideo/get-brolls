# Workspace wrapper environment (non-secret): the env-var way of doing what getbrolls.toml does.
export GET_BROLLS_ROOT="@CHECKOUT@"
export GET_BROLLS_BASELINE="@VERSION@"
export GET_BROLLS_BRANCH="release"

export GB_HOME="@WS@/.getbrolls"
export GB_CACHE_DIR="@WS@/.cache/getbrolls"

export GB_VENV_PATH="@WS@/tools/beta/.venv"
export GB_YTDLP_PATH="@WS@/tools/beta/.venv/@BIN@/yt-dlp@EXE@"

export GB_FFMPEG_PATH="@FFMPEG@"
export GB_FFPROBE_PATH="@FFPROBE@"

export GB_PLUGINS="off"
