{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Get B-rolls analysis transcript v1",
  "$id": "https://raw.githubusercontent.com/engenheirodevideo/get-brolls/v2.6.0/schemas/transcript.schema.json",
  "description": "analysis/media/<media_id>/transcript.json: fala palavra a palavra. A palavra fica em text (convenção do sidecar HyperFrames), não em word como no Nômade; word_count é len(words) e start <= end (conferidos em código). Objetos abertos: campo novo opcional entra fora de required e o leitor ignora chave desconhecida; remover, renomear ou mudar o significado de um campo sobe o N de schema. Leitor recusa N maior do que conhece.",
  "type": "object",
  "required": [
    "schema",
    "media_id",
    "status",
    "reason",
    "producer",
    "created",
    "time_unit",
    "language",
    "text",
    "word_count",
    "words"
  ],
  "properties": {
    "schema": {
      "const": "getbrolls.transcript/1"
    },
    "media_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Primeiros 16 hex do sha256 dos bytes da mídia (o asset_id do Nômade tem a mesma derivação)."
    },
    "status": {
      "enum": [
        "done",
        "done_partial",
        "unavailable",
        "failed",
        "blocked",
        "not_run_by_this_script",
        "no_speech"
      ],
      "description": "Estado do componente. unavailable, failed, blocked e not_run_by_this_script exigem reason (conferido em código)."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "producer": {
      "type": "object",
      "required": [
        "tool",
        "model",
        "version"
      ],
      "description": "Quem gerou o dado: a ferramenta (id do plugin ou getbrolls), o modelo e a versão.",
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "time_unit": {
      "const": "s"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16
    },
    "text": {
      "type": "string"
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "start",
          "end",
          "probability",
          "speaker"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "description": "Segundos (time_unit s), número finito (NaN e infinito recusados em código)."
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "description": "Segundos (time_unit s), número finito (NaN e infinito recusados em código)."
          },
          "probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          }
        }
      }
    }
  }
}
