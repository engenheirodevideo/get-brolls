{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "getbrolls pending transaction v1",
  "$id": "https://raw.githubusercontent.com/engenheirodevideo/get-brolls/v2.6.0/schemas/pending_transaction.schema.json",
  "description": "brolls/.pending-transaction.json: o journal de uma gravação em andamento. Sem schema_version (2.5) vale 1. `data` é o manifesto novo; `events` são as linhas do events.jsonl; `publish` guarda os clipes a publicar.",
  "type": "object",
  "required": [
    "data",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "data": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transaction"
        ],
        "properties": {
          "transaction": {
            "type": "string"
          }
        }
      }
    },
    "publish": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
