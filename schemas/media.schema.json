{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Get B-rolls analysis media v1",
  "$id": "https://raw.githubusercontent.com/engenheirodevideo/get-brolls/v2.6.0/schemas/media.schema.json",
  "description": "analysis/media/<media_id>/media.json: identidade e dados técnicos de uma mídia do projeto. media_id é sha256[:16] (conferido em código); o sha256 inteiro fica aqui. Objetos abertos: campo novo opcional entra fora de required e o leitor ignora chave desconhecida; remover, renomear ou mudar o significado de um campo sobe o N de schema. Leitor recusa N maior do que conhece.",
  "type": "object",
  "required": [
    "schema",
    "media_id",
    "status",
    "reason",
    "producer",
    "created",
    "time_unit",
    "path",
    "sha256",
    "size_bytes",
    "quick_key",
    "role",
    "duration_s",
    "fps",
    "width",
    "height",
    "has_audio",
    "video_codec",
    "audio_codec"
  ],
  "properties": {
    "schema": {
      "const": "getbrolls.media/1"
    },
    "media_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Primeiros 16 hex do sha256 dos bytes da mídia (o asset_id do Nômade tem a mesma derivação)."
    },
    "status": {
      "enum": [
        "done",
        "done_partial",
        "unavailable",
        "failed",
        "blocked",
        "not_run_by_this_script",
        "no_speech"
      ],
      "description": "Estado do componente. unavailable, failed, blocked e not_run_by_this_script exigem reason (conferido em código)."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "producer": {
      "type": "object",
      "required": [
        "tool",
        "model",
        "version"
      ],
      "description": "Quem gerou o dado: a ferramenta (id do plugin ou getbrolls), o modelo e a versão.",
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "time_unit": {
      "const": "s"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Caminho relativo à raiz do projeto, com /. Nunca absoluto, nunca com . ou .. (conferido em código)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "quick_key": {
      "type": "object",
      "required": [
        "size",
        "mtime_ns",
        "sample_sha256"
      ],
      "description": "Cache do registro: tamanho, mtime em ns e sha256 de uma amostra (1 MiB do início + 1 MiB do fim). Tamanho e mtime iguais pulam o hash completo; qualquer mudança em um dos dois refaz o sha256 inteiro (a amostra nunca prova que o conteúdo é o mesmo).",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mtime_ns": {
          "type": "integer",
          "minimum": 0
        },
        "sample_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "role": {
      "enum": [
        "aroll",
        "broll",
        "footage",
        "music",
        "sfx",
        "narration",
        "title",
        "animation",
        "unknown"
      ],
      "description": "Papel da mídia no projeto; mesmos nomes do contrato do otio-edit."
    },
    "duration_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "fps": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[1-9][0-9]{0,9}/[1-9][0-9]{0,9}$",
      "description": "Fração de quadros por segundo como texto num/den, como o ffprobe escreve (30000/1001); null sem vídeo ou sem ffprobe."
    },
    "width": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "height": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "has_audio": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "video_codec": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "audio_codec": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  }
}
